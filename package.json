{
  "name": "ai-saas-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:tailscale": "node scripts/bootstrap-tailscale.mjs",
    "bootstrap:status": "node scripts/bootstrap-control.mjs status",
    "bootstrap:wait": "node scripts/bootstrap-control.mjs wait",
    "bootstrap:stop": "node scripts/bootstrap-control.mjs stop",
    "setup:check": "node scripts/doctor.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "test:bootstrap": "node --test scripts/*.test.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm test:bootstrap && pnpm test:app",
    "test:app": "vitest run",
    "test:integration": "node scripts/heavy-command.mjs node --test tests/integration/*.test.mjs",
    "test:e2e": "node scripts/heavy-command.mjs playwright test",
    "test:e2e:critical": "node scripts/heavy-command.mjs playwright test --grep @critical",
    "test:e2e:affected": "node scripts/e2e-affected.mjs",
    "inspect": "node scripts/inspect.mjs",
    "capture": "node scripts/capture.mjs",
    "review-link": "node scripts/review-link.mjs",
    "clerk:sweep": "node scripts/clerk-sweep.mjs",
    "pr:gate": "node scripts/pr-gate.mjs",
    "polar:trigger": "node scripts/polar-trigger.mjs",
    "dev": "convex dev --start 'next dev'",
    "typecheck": "tsc --noEmit && tsc -p convex --noEmit",
    "build": "node scripts/heavy-command.mjs --no-headroom sh -c 'pnpm run typecheck && next build'",
    "build:vercel": "pnpm test:app && pnpm lint && convex deploy --cmd 'pnpm exec next build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL && node scripts/sync-maintenance-mode.mjs",
    "start": "next start",
    "lint": "pnpm run typecheck && eslint ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.2",
    "@clerk/ui": "^1.43.0",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "@polar-sh/sdk": "~1.0.2",
    "@sentry/nextjs": "^11.14.0",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.5.2",
    "convex": "^1.51.0",
    "convex-helpers": "^0.1.136",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "svix": "^2.10.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@ts-morph/common>minimatch": "^11.0.1"
    },
    "onlyBuiltDependencies": [
      "@polar-sh/cli",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@clerk/testing": "^2.3.1",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.1",
    "@polar-sh/cli": "^3.2.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.72",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
