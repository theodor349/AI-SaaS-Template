{
  "name": "ai-saas-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:tailscale": "node scripts/bootstrap-tailscale.mjs",
    "test:bootstrap": "node --test scripts/*.test.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm test:bootstrap && pnpm test:app",
    "test:app": "vitest run",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "inspect": "node scripts/inspect.mjs",
    "polar:trigger": "node scripts/polar-trigger.mjs",
    "dev": "convex dev --start 'next dev'",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && next build",
    "build:vercel": "pnpm test:app && pnpm lint && convex deploy --cmd 'pnpm exec next build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "lint": "pnpm run typecheck && eslint ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.10",
    "@polar-sh/sdk": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.4.0",
    "convex": "^1.44.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "svix": "^2.8.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@polar-sh/cli",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.43",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@polar-sh/cli": "^2.0.1",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
