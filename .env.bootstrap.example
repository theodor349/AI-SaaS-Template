# Copy to .env.bootstrap.local in the main checkout. Linked worktrees read it.
# Override credentials with .env.bootstrap.local in an individual worktree.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional authenticated fallback, e.g. payment onboarding at /app/checkout.
NEXT_PUBLIC_AUTHENTICATED_DESTINATION=/app

# Create an organization access token at sandbox.polar.sh, not polar.sh.
POLAR_ACCESS_TOKEN=
# Optional when the token can access more than one sandbox organization.
POLAR_ORGANIZATION_ID=

# Three distinct paid fixed-price products in that sandbox organization.
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=
POLAR_PRODUCT_LIFETIME=

# Ports, local URLs, WORKTREE_ID, Clerk issuer, and the Polar webhook secret
# are configured by the bootstrap script. Do not copy production credentials.

# Optional: Svix signing secret for a Clerk development webhook endpoint.
# Without one, bootstrap creates a worktree-local secret for signed HTTP tests.
# Local sign-in provisions through Clerk's Backend API; no public tunnel is needed.
CLERK_WEBHOOK_SIGNING_SECRET=
