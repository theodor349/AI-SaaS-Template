# Copy to .env.bootstrap.local in the main checkout. Linked worktrees read it.
# Override credentials with .env.bootstrap.local in an individual worktree.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional authenticated fallback, e.g. payment onboarding at /app/checkout.
NEXT_PUBLIC_AUTHENTICATED_DESTINATION=/app

# Create an organization access token at sandbox.polar.sh, not polar.sh. Withdrawal
# refunds need its refunds:read and refunds:write scopes.
POLAR_ACCESS_TOKEN=
# Optional when the token can access more than one sandbox organization.
POLAR_ORGANIZATION_ID=

# Required for billing: three distinct paid fixed-price sandbox products.
# Set these once in the main checkout; all linked worktrees inherit them.
# Blank optional values in a worktree keep the inherited configuration.
# Prices are synced from Polar before bootstrap reports Ready.
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=
POLAR_PRODUCT_LIFETIME=

# Ports, local URLs, WORKTREE_ID, Clerk issuer, and the Polar webhook secret
# are configured by the bootstrap script. Do not copy production credentials.

# Optional: Svix signing secret for a Clerk development webhook endpoint.
# Without one, bootstrap creates a worktree-local secret for signed HTTP tests.
# Local sign-in provisions through Clerk's Backend API; no public tunnel is needed.
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional: success-event sampling, between 0 and 1. Defaults are 0 for
# queries and 1 for mutations and actions; errors are always logged.
# LOG_SAMPLE_RATE_QUERY=1
# LOG_SAMPLE_RATE_MUTATION=1
# LOG_SAMPLE_RATE_ACTION=1

# Sentry is optional and configured only on hosted deployments (docs/deployment.md).
# Bootstrap reports Sentry events to a fake local endpoint, so no DSN belongs here.

# Per worktree only: if this worktree's path-derived ports collide, set
# BOOTSTRAP_PORT_BLOCK=<0-11999> in its own .env.bootstrap.local. The main
# checkout's value is not inherited. pnpm bootstrap --print shows the ports.
