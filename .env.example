# Written by `pnpm exec convex dev` after selecting your Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Copy from your Clerk application's API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set CLERK_JWT_ISSUER_DOMAIN on your Convex deployment, not in this file.
# Set these on the Convex deployment as well: the Clerk Backend API key enables
# authenticated provisioning when a user.created webhook is delayed or missing.
# CLERK_SECRET_KEY=sk_...
# Register /webhooks/clerk on the Convex HTTP URL for user.created/updated/deleted.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
