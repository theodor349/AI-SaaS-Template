# Written by `pnpm exec convex dev` after selecting your Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Copy from your Clerk application's API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Authenticated fallback after sign-in/up. Requested local destinations take precedence.
# Point at payment onboarding (e.g. /app/checkout); signing in does not grant paid access.
NEXT_PUBLIC_AUTHENTICATED_DESTINATION=/app

# Set CLERK_JWT_ISSUER_DOMAIN on each Convex deployment, not in this file.
# Use that environment's Clerk Frontend API URL as issuer (dev and prod differ).
# Enable Clerk's Convex integration or a JWT template named "convex" with aud="convex".
